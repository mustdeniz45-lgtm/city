{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cityquest",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Capture photos for your CityQuest postcards",
        "NSPhotoLibraryUsageDescription": "Select travel photos for your postcards",
        "NSPhotoLibraryAddUsageDescription": "Save your CityQuest postcards to your gallery",
        "NSLocationWhenInUseUsageDescription": "Verify your quest check-ins by location",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.emergent.localexplorergame.m0go0p"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.emergent.localexplorergame.m0go0p"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Select travel photos for your CityQuest postcards",
          "cameraPermission": "Capture photos for your CityQuest postcards"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Save your CityQuest postcards to your gallery",
          "savePhotosPermission": "Save your CityQuest postcards to your gallery"
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c43add56-a917-4d38-8a24-d3f7dbd5f53e"
      }
    },
    "owner": "mdeniz1"
  }
}